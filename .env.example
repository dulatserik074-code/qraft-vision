# Добавьте минимум один provider. Ключи хранятся только на backend/Render.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENROUTER_API_KEY=
OPENROUTER_MODEL=

HF_TOKEN=
HF_VISION_MODEL=

# Mock никогда не включать в production.
ALLOW_MOCK_VISION=false
PUBLIC_APP_URL=http://localhost:5173
PORT=3000
